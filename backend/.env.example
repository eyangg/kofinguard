# backend/.env.example — 항목 이름과 설명만 둡니다. 실제 값은 backend/.env에 넣습니다 (Git 제외).
# 이 파일을 복사해 backend/.env를 만들고 값을 채웁니다. 키·비밀번호는 채팅이나 코드에 붙여 넣지 않습니다.

# DB 연결 문자열. 없으면 서버는 SQLite로 자동 전환하지 않고 멈춥니다.
#  - 로컬 개발(Phase 2~7): sqlite:///./kofinguard.db  (backend 폴더 기준 파일)
#  - 시연(Phase 8): Supabase 대시보드 → Connect → Session pooler 문자열
#      postgresql://postgres.[프로젝트ref]:[비밀번호]@aws-...pooler.supabase.com:5432/postgres
#      [비밀번호]를 실제 DB 비밀번호로 바꿉니다. 비밀번호·전체 문자열은 채팅에 붙이지 않습니다.
DATABASE_URL=

# OpenAI 키 (docs/setup_api.md)
OPENAI_API_KEY=
# 챗봇 모델 이름. function calling 지원 + temperature=0 가능한 작은 모델
OPENAI_MODEL=gpt-4.1-mini
# 답변 최대 길이
OPENAI_MAX_TOKENS=300

# local일 때만 방어 OFF 챗봇 허용
KFG_ENV=local
# 로그인 쿠키 서명 키 (32자 이상 무작위 문자열). 없으면 서버가 시작하지 않습니다.
# 만드는 법: .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
KFG_SESSION_SECRET=

# SmoothPPL용 Qwen GGUF 파일 경로 (backend 폴더 기준)
KFG_QWEN_GGUF_PATH=../models/qwen2.5-3b-instruct-q4_k_m.gguf
# Ollama 주소와 Llama Guard 모델. 배포 결정: 1b 유지(8b 대비 오탐 13%vs7%이나 CPU·비용·속도 이점,
# 오탐은 '탐지기만으론 부족→서버 방어 필요' 근거로 활용). 1b는 Lightsail 8GB로 충분.
KFG_OLLAMA_URL=http://127.0.0.1:11434
KFG_GUARD_MODEL=llama-guard3:1b
# SmoothPPL 평균 PPL 기준값. 넘으면 '다시 묻기'(막지 않음). Phase 6 결정: 5000 (정상 질문 30개 최댓값 약 3,134)
KFG_PPL_THRESHOLD=5000
# SmoothPPL 교란 샘플 수(1회 검사당 모델 추론 횟수). 비우면 15(졸프 값).
# CPU만 쓰는 배포에서 속도를 위해 줄인다(예: 6). 바꾸면 calibrate로 임계값 재확인.
KFG_PPL_NUM_SAMPLES=
# 1/true면 서버 시작 때 탐지기 모델을 미리 로드(첫 ON 요청의 콜드 지연·502 방지). CPU 배포 권장.
KFG_PRELOAD_DETECTOR=

# ---- 배포 전용 (로컬은 전부 비워 두면 기존과 동일하게 동작) ----
# 단일 출처 배포(bankguard.axworks.site 한 곳, Caddy가 프론트+/api 서빙) 기준 값:
#   KFG_API_ORIGIN=https://bankguard.axworks.site
#   KFG_COOKIE_SECURE=1
#   KFG_ATTACKER_BASE=/api/demo
#   (KFG_FRONTEND_ORIGIN·KFG_COOKIE_CROSS_SITE는 비워 둔다 — 동일 출처라 CORS·None 불필요)

# 백엔드 공개 출처. 유출 스크립트가 /api/me·/collect를 부를 절대 주소에 쓴다.
KFG_API_ORIGIN=
# (단일 출처) 1/true면 lax 쿠키에 Secure 추가. HTTPS 전제.
KFG_COOKIE_SECURE=
# S2 유출 수집 지점. 비우면 로컬 기본 //127.0.0.1:9999(독립 공격자 서버).
# 단일 출처 배포는 /api/demo (같은 출처의 백엔드 수집 엔드포인트).
KFG_ATTACKER_BASE=
# (교차사이트 배포 전용 — 서브도메인 분리 시에만) 프론트 출처 CORS 허용 / None+Secure 쿠키
KFG_FRONTEND_ORIGIN=
KFG_COOKIE_CROSS_SITE=
