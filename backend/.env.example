# backend/.env.example — 항목 이름과 설명만 둡니다. 실제 값은 backend/.env에 넣습니다 (Git 제외).
# 이 파일을 복사해 backend/.env를 만들고 값을 채웁니다. 키·비밀번호는 채팅이나 코드에 붙여 넣지 않습니다.

# DB 연결 문자열. 없으면 서버는 SQLite로 자동 전환하지 않고 멈춥니다.
#  - 로컬 개발(Phase 2~7): sqlite:///./kofinguard.db  (backend 폴더 기준 파일)
#  - 시연(Phase 8): Supabase Session pooler 연결 문자열
DATABASE_URL=

# OpenAI 키 (docs/setup_api.md)
OPENAI_API_KEY=
# 챗봇 모델 이름. function calling 지원 + temperature=0 가능한 작은 모델
OPENAI_MODEL=gpt-4.1-mini
# 답변 최대 길이
OPENAI_MAX_TOKENS=300

# local일 때만 방어 OFF 챗봇 허용
KFG_ENV=local
# 로그인 쿠키 서명 키 (32자 이상 무작위 문자열). 없으면 서버가 시작하지 않습니다.
# 만드는 법: .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
KFG_SESSION_SECRET=

# SmoothPPL용 Qwen GGUF 파일 경로 (backend 폴더 기준)
KFG_QWEN_GGUF_PATH=../models/qwen2.5-3b-instruct-q4_k_m.gguf
# Ollama 주소와 Llama Guard 모델
KFG_OLLAMA_URL=http://127.0.0.1:11434
KFG_GUARD_MODEL=llama-guard3:8b
# 이상한 문장 점수 기준값 (Phase 6에서 정상 문장 점수를 보고 결정)
KFG_PPL_THRESHOLD=
